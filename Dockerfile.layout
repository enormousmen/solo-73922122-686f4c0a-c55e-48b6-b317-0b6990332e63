# Builds the two deterministic demo OCI layouts into the shared volumes
# `oci-layout` (full primary library) and `oci-layout-standby` (restricted
# backup library: stable v1 on both architectures plus one arm64 v2 candidate),
# then exits.  Everything else in the stack only reads from those volumes,
# except the API's own state volume.
FROM python:3.11-slim

WORKDIR /srv
COPY scripts ./scripts

# Size asymmetry makes the two commit-order races in examples/demo_switch.py
# visibly deterministic with LAYER_CHUNK_DELAY_MS=1:
#   * stable v1 amd64 layers are moderate  -> switch validation is a window
#     in which the tiny arm64 v2 publish can commit first;
#   * amd64 v2/v3 candidate layers are huge -> an in-flight amd64 publish is
#     still scanning when the switch validates the smaller v1 and commits.
# arm64 stays tiny so the concurrent demo remains snappy.
CMD ["python", "scripts/build_layout.py", "--pair", "--out", "/oci-layout", "--meta", "/oci-layout/demo-digests.json", "--standby-out", "/oci-layout-standby", "--standby-meta", "/oci-layout-standby/demo-standby-digests.json", "--layers", "2", "--v1-amd64-payload-bytes", "8388608", "--v1-arm64-payload-bytes", "8192", "--candidate-amd64-payload-bytes", "33554432", "--candidate-arm64-payload-bytes", "8192"]
